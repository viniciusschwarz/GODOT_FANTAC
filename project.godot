; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fantac"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/graphics/sprites/icon.svg"

[autoload]

GameHub="*uid://dvh2di0dqvg67"
Pathfinder="*uid://b5pyoeb1ie35f"
UnitDatabase="*uid://c6x3tkdbegytn"
TerrainDatabase="*res://scripts/autoloads/TerrainDatabase.gd"
AIDatabase="*res://scripts/autoloads/AIDatabase.gd"
MapGenerator="*res://scripts/gameplay/MapGenerator.gd"
SignalBus="*res://scripts/autoloads/signal_bus.gd"
GameState="*res://scripts/autoloads/game_state.gd"
SceneManager="*res://scripts/autoloads/scene_manager.gd"
SettingsManager="*res://scripts/autoloads/settings_manager.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
run/main_scene="res://scenes/ui/screens/boot_screen.tscn"
