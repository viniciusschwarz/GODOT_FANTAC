	# 10-19: Framing & Protocol Failures
	REJECTED_INVALID_ENVELOPE = 10,
	REJECTED_STALE_TICK = 11,
	REJECTED_RATE_LIMITED = 12,

	# 20-39: Domain Preconditions & Availability
	REJECTED_PRECONDITION = 20,
