	REJECTED_OUT_OF_RANGE = 23,
	REJECTED_INSUFFICIENT_FUNDS = 24,
	REJECTED_CAPACITY_FULL = 25,

	# 40-59: Concurrency, Locks & Identity
	REJECTED_TARGET_LOCKED = 40,
	ABORTED_TARGET_INVALID = 41,
	ABORTED_TARGET_DISPOSED = 42,
	ABORTED_ACTOR_INCAPACITATED = 43,

	# 60+: Catastrophic Engine Failures
